#!/bin/sh
# Docker/Coolify health check for the backup runner: unhealthy after any failed
# backup attempt or when no backup completed in the previous 36 hours. In
# preview/backups-disabled mode the runner marks itself successful at startup
# so the healthcheck stays green.
set -u
STATE_DIR=/var/lib/veerify-redis-backup
LAST_SUCCESS_FILE="$STATE_DIR/last-success"
LAST_FAILURE_FILE="$STATE_DIR/last-failure"
MAX_AGE_HOURS=36

if [ -f "$LAST_FAILURE_FILE" ]; then
  echo "last scheduled backup attempt failed ($(cat "$LAST_FAILURE_FILE"))"
  exit 1
fi

if [ ! -f "$LAST_SUCCESS_FILE" ]; then
  echo "no successful backup recorded yet"
  exit 1
fi

age=$(python3 /usr/local/lib/veerify-redis-backup/backup-state.py age "$LAST_SUCCESS_FILE") || exit 1
if [ "$age" -gt "$MAX_AGE_HOURS" ]; then
  echo "last backup was ${age}h ago (limit ${MAX_AGE_HOURS}h)"
  exit 1
fi
echo "last backup ${age}h ago"
