#!/bin/sh
# Docker/Coolify health check for the backup runner: unhealthy after any failed
# backup attempt or when no backup completed in the previous 36 hours. In
# preview/backups-disabled mode the runner marks itself successful at startup
# so the healthcheck stays green.
set -u
case "${BACKUP_REQUIRED:-}:${BACKUP_ENABLED:-}" in
  true:true) ;;
  false:false)
    echo "backup disabled for Preview"
    exit 0
    ;;
  *)
    echo "BACKUP_REQUIRED and BACKUP_ENABLED must both be true for Production or false for Preview"
    exit 1
    ;;
esac

STATE_DIR=/var/lib/veerify-redis-backup
LAST_SUCCESS_FILE="$STATE_DIR/last-success"
LAST_FAILURE_FILE="$STATE_DIR/last-failure"
MAX_AGE_SECONDS=129600

if [ -f "$LAST_FAILURE_FILE" ]; then
  echo "last scheduled backup attempt failed ($(cat "$LAST_FAILURE_FILE"))"
  exit 1
fi

if [ ! -f "$LAST_SUCCESS_FILE" ]; then
  echo "no successful backup recorded yet"
  exit 1
fi

age_seconds=$(python3 /usr/local/lib/veerify-redis-backup/backup-state.py age-seconds "$LAST_SUCCESS_FILE") || exit 1
case "$age_seconds" in ''|*[!0-9]*) echo "invalid backup age: $age_seconds"; exit 1 ;; esac
if [ "$age_seconds" -gt "$MAX_AGE_SECONDS" ]; then
  echo "last backup was ${age_seconds}s ago (limit ${MAX_AGE_SECONDS}s)"
  exit 1
fi
echo "last backup ${age_seconds}s ago"
