## Client-Side Patterns

### Client Detection
::callout{type="warning"}
Use `import.meta.client` (NOT `process.client` - deprecated)
::

```javascript
// ✅ Correct
if (import.meta.client) {
  // client-only code
  localStorage.setItem('key', 'value')
}

// ❌ Deprecated
if (process.client) {
  // Don't use this
}
```

### Navigation
```vue
<script>
export default {
  methods: {
    // Programmatic navigation
    async goToDashboard() {
      await navigateTo('/dashboard')
    },
    
    // External navigation
    openExternal() {
      if (import.meta.client) {
        window.open('https://example.com', '_blank')
      }
    }
  }
}
</script>

<template>
  <!-- Declarative navigation -->
  <NuxtLink to="/dashboard" class="hover:underline">
    Dashboard
  </NuxtLink>
</template>
```

## Authentication Patterns

### Client-Side Auth
```vue
<script>
import { authClient } from '~/lib/auth-client'

export default {
  data() {
    return {
      session: null,
      organizations: [],
      activeOrganization: null
    }
  },
  
  async mounted() {
    // Session management
    const { data: session } = await authClient.useSession(useFetch)
    this.session = session.value
    
    // Organization management (if using org plugin)
    const { data: orgs } = authClient.useListOrganizations()
    const { data: activeOrg } = authClient.useActiveOrganization()
    
    this.organizations = orgs.value || []
    this.activeOrganization = activeOrg.value
  },
  
  methods: {
    async logout() {
      await authClient.signOut()
      await navigateTo('/auth')
    },
    
    async setActiveOrg(orgId) {
      await authClient.organization.setActive({ organizationId: orgId })
    }
  }
}
</script>
```

## Error Handling

::callout{type="danger"}
NO fallback data - show proper error states
::

```vue
<template>
  <div v-if="error" class="p-4 border border-red-200 rounded-lg bg-red-50">
    <div class="flex items-center gap-2 text-red-600">
      <Icon name="lucide:alert-circle" class="h-4 w-4" />
      <span class="font-medium">{{ error }}</span>
    </div>
    <Button 
      variant="outline" 
      size="sm" 
      class="mt-2"
      @click="retryOperation"
    >
      <Icon name="lucide:refresh-cw" class="h-4 w-4 mr-2" />
      Retry
    </Button>
  </div>
</template>
``` 