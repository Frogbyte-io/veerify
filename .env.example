# Database Configuration
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgresql://user:password@host:5432/database
# Database TLS policy: only `disable` or `verify-full` are accepted. With a
# production DATABASE_URL and no explicit mode, the default is verify-full.
# Leave empty for the local non-TLS default. Provider URL sslmode parameters and
# PGSSLMODE do not override this resolved policy.
DATABASE_SSL_MODE=
# Optional PEM CA certificate for verify-full. Do not set this with disable.
DATABASE_SSL_CA=

# Option 2: Use individual variables (local development with Docker)
# PG* connections remain non-TLS by default, including in production. For a
# remote PG* database, explicitly set DATABASE_SSL_MODE=verify-full.
POSTGRES_USER=veerify
POSTGRES_PASSWORD=veerifypassword
POSTGRES_DB=veerifydb
PGHOST=localhost
PGPORT=5432
# Max connections in the app's pg pool (default 20, max 200). Web requests and the scheduled Marketing
# tasks share it; keep it below Postgres max_connections divided by the number of app replicas.
PG_POOL_MAX=

# BetterAuth Configuration
BETTER_AUTH_CLIENT_ID=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your dashboard app (use https://app.veerify.io in production)
# Secret key rotation (BetterAuth 1.5+): when rotating BETTER_AUTH_SECRET, set the OLD secret here.
# New data is encrypted with BETTER_AUTH_SECRET; BETTER_AUTH_SECRET_PREV decrypts any data
# encrypted with the previous key. Once all old sessions have expired you can remove this.
# BETTER_AUTH_SECRET_PREV=
# Optional dedicated key for the keyed email hashes Marketing keeps after anonymising addresses
# (suppression, erase, dedupe). Set once, NEVER rotate. When unset the hash key is derived from
# BETTER_AUTH_SECRET (lookups also try BETTER_AUTH_SECRET_PREV).
# MARKETING_EMAIL_HASH_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub OAuth app callback URL should be:
#   https://<your-dashboard-host>/api/auth/callback/github
# Veerify's product GitHub integration uses a nested callback under that path.

# App Domain (used for subdomain-based public pages: team-slug.APP_DOMAIN)
APP_DOMAIN=localhost
# Dashboard domain (used by login/signup links from public boards)
# Defaults to app.<APP_DOMAIN> when omitted in non-local environments.
APP_DASHBOARD_DOMAIN=localhost
# Optional public URL used in outbound CSAT rating links. Set this to the
# customer-facing HTTPS origin in production; it must be an absolute URL.
APP_URL= # Optional public origin; leave empty to fall back to BETTER_AUTH_URL
# Optional: "self-hosted" or "cloud". When omitted, auto-detected from platform env vars.
APP_DEPLOYMENT_MODE=self-hosted
# Optional, development only. Comma-separated extra Host headers the Vite dev server
# will accept, for reaching `yarn dev` through an HTTPS reverse proxy such as
# Tailscale Serve. Leave empty unless you use one. Example: dev.my-tailnet.ts.net
NUXT_DEV_ALLOWED_HOSTS=

# CNAME target for custom domain setup (point users' CNAMEs here)
CNAME_TARGET=cname.veerify.io

# Domain provider for project custom domains: "static-cname" keeps the
# existing manual CNAME flow (the default);
# "cloudflare-saas" registers customer hostnames with Cloudflare for SaaS
# (Custom Hostnames) on the zone that owns CNAME_TARGET.
DOMAIN_PROVIDER=static-cname
# Required when DOMAIN_PROVIDER=cloudflare-saas. Secret. Create an API token with
# ONLY Zone > SSL and Certificates > Edit, scoped to the veerify.io zone.
# Prebuilt images can set NUXT_DOMAIN_PROVIDER, NUXT_CLOUDFLARE_API_TOKEN and
# NUXT_CLOUDFLARE_ZONE_ID at runtime instead (CNAME_TARGET: NUXT_PUBLIC_CNAME_TARGET).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Inbound support email provider. Webhook-only: there is no IMAP polling
# (delta D-29). The [provider] segment of /api/support/inbound/[provider]
# selects the driver per request; this names the deployment's default.
SUPPORT_CHANNEL_PROVIDER=postmark

# Postmark does NOT sign inbound webhooks - its documented protection is HTTP
# Basic Auth in the webhook URL plus IP allowlisting. Set both, then register
# https://user:password@your-host/api/support/inbound/postmark with Postmark.
# Inbound mail is rejected while these are unset; an empty credential must
# never mean "accept anything".
SUPPORT_POSTMARK_WEBHOOK_USER=
SUPPORT_POSTMARK_WEBHOOK_PASSWORD=

# Required when using Mailgun. This is the webhook signing key (not the API
# key); Mailgun signs HMAC-SHA256(timestamp + token) with it.
SUPPORT_MAILGUN_SIGNING_KEY=

# OPTIONAL, Stage 04. Used only to check whether an inbox's From address sits
# on a domain the provider will actually accept, so /support/settings can warn
# before mail silently fails at send time. Leave unset and the check reports
# "cannot verify" rather than a false warning - nothing else is affected.
#
# Postmark: this is the ACCOUNT token, not a server token. The /domains
# endpoint is account-level and a server token returns 401 there.
SUPPORT_POSTMARK_ACCOUNT_TOKEN=
# Non-secret deployment account identifier persisted with outbound deliveries.
# MUST equal the value the provider reports on its own delivery webhooks, or the
# delivery-correlation fallback can never match: for Postmark that is the numeric
# `ServerID`. The primary correlation path uses our own metadata key and works
# regardless, but the fallback is the only defence when a provider drops that
# metadata on an event. Unverified against a live account - see
# docs/plans/2026-08-11-support-platform/stage-01-04-provider-checklist.md.
SUPPORT_POSTMARK_ACCOUNT_KEY=
# Mailgun: the private API key. Frogmail: a key with `domains:read`, plus
# `domains:manage` when SUPPORT_SENDING_DOMAINS_ENABLED=true (and `routes:manage`
# for direct receiving, `usage:read` with MAIL_FORWARDING_ENABLED). It MUST be a different key from SMTP_PASS, which keeps
# only `emails:send`, so domain polling never shares the per-key rate limit
# with sending. See docs/deployment-mail.md.
SUPPORT_MAILGUN_API_KEY=
# As above: must equal what Mailgun reports on its webhooks, i.e. the sending domain.
SUPPORT_MAILGUN_ACCOUNT_KEY=
# Empty means https://api.mailgun.net. Set it for EU accounts
# (https://api.eu.mailgun.net) or to a Frogmail origin (no path).
SUPPORT_MAILGUN_API_BASE_URL=
# Frogmail with SES receiving: connected domains receive mail directly and addresses
# can forward to external mailboxes. Also needs `usage:read` on SUPPORT_MAILGUN_API_KEY
# and FROGMAIL_WEBHOOK_SECRET below. See docs/deployment-mail.md → Receiving and forwarding.
MAIL_FORWARDING_ENABLED=false
# Frogmail native webhook signing secret(s), comma-separated to rotate. Enables
# POST /api/support/frogmail/events (404 while empty). Create the endpoint on Frogmail with
# POST /api/v1/webhook-endpoints, url <BETTER_AUTH_URL>/api/support/frogmail/events and events
# forward_destination.verified, forward_destination.revoked, forward_destination.suspended.
FROGMAIL_WEBHOOK_SECRET=

# How support replies leave: `smtp` (default, the SMTP_* transport below) or
# `mailgun` (POST {SUPPORT_MAILGUN_API_BASE_URL}/v3/{From domain}/messages, the
# Mailgun-compatible HTTP API of Mailgun or Frogmail). System mail always uses
# SMTP. Recommended with Frogmail: customer domains are verified there, not on
# the SMTP provider. See docs/deployment-mail.md → Using Frogmail.
SUPPORT_SEND_TRANSPORT=smtp
# Used with SUPPORT_SEND_TRANSPORT=mailgun. Frogmail: a key with only `emails:send`.
# Empty falls back to SUPPORT_MAILGUN_API_KEY (with a warning), which then needs
# `emails:send` and shares its per-key rate limit with domain polling.
SUPPORT_MAILGUN_SEND_API_KEY=

# Using Frogmail (Mailgun-compatible): set SUPPORT_SEND_TRANSPORT=mailgun and
# SUPPORT_MAILGUN_SEND_API_KEY above (or point SMTP_* at the Frogmail SMTP
# submission gateway: port 587, SMTP_USER=api, SMTP_PASS=a Frogmail API key
# with emails:send), set SUPPORT_CHANNEL_PROVIDER=mailgun and the
# SUPPORT_MAILGUN_* values above from the Frogmail project, and configure the
# webhooks /api/support/delivery/mailgun and /api/support/inbound/mailgun in
# Frogmail. Rollback is reverting these values. See docs/deployment-mail.md.

# Customer sending domains (docs/deployment-mail.md, "Customer sending domains").
# Lets project admins register their own sending domain on /support/settings.
# Turning it on forces the `project` sender policy: a From address must sit on a
# verified domain of the inbox's project (or be its Veerify platform address).
# Roll back by setting it to false; claims stay in the database.
SUPPORT_SENDING_DOMAINS_ENABLED=false
# `legacy` or `project` (`team` is accepted as an alias). Empty means `project`
# when the flag above is true, otherwise `legacy`. `legacy` together with the flag
# above is a misconfiguration and logs an error; `project` applies.
SUPPORT_SENDER_POLICY=
# Apex zone that receives mail through the provider and verifies for sending, used
# for per-inbox forwarding addresses such as <team>-<inbox>-<suffix>@<this domain>.
# Empty means no platform addresses are created.
SUPPORT_PLATFORM_MAIL_DOMAIN=
# Comma-separated extra domains no team may claim (the domains of MAIL_FROM,
# SYSTEM_MAIL_FROM, SUPPORT_MAILGUN_ACCOUNT_KEY, APP_DOMAIN and
# SUPPORT_PLATFORM_MAIL_DOMAIN are always reserved).
SUPPORT_SENDING_DOMAINS_RESERVED=
# Where created inbound routes forward to. Empty means
# ${BETTER_AUTH_URL}/api/support/inbound/<provider>.
SUPPORT_INBOUND_WEBHOOK_URL=
# Where the delivery webhooks Veerify creates for verified Mailgun/Frogmail sending
# domains point (delivered, permanent_fail, temporary_fail, complained). Empty means
# ${BETTER_AUTH_URL}/api/support/delivery/mailgun.
SUPPORT_DELIVERY_WEBHOOK_URL=
# Development and e2e only: `fake` replaces the provider with an in-memory one.
# Refused (ignored with an error) when NODE_ENV=production.
SUPPORT_SENDING_DOMAIN_PROVIDER=


# SMTP Configuration for nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=noreply@yourapp.com
MAIL_FROM_NAME=Your App Name

# OPTIONAL dedicated transport for system mail: sign-in links, verification,
# password reset, invitations, notifications and digests. Support replies
# use SMTP_* above unless SUPPORT_SEND_TRANSPORT=mailgun. Leave SYSTEM_SMTP_HOST empty to send everything
# through SMTP_* (the default). Typical use: support mail through Frogmail via
# SMTP_*, account mail kept on Resend here. See docs/deployment-mail.md.
SYSTEM_SMTP_HOST=
# Defaults to 465 when SYSTEM_SMTP_SECURE=true, otherwise 587.
SYSTEM_SMTP_PORT=
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
# Defaults to MAIL_FROM.
SYSTEM_MAIL_FROM=

# Storage Configuration (logo/banner uploads)
# STORAGE_DRIVER can be "local" or "s3"
STORAGE_DRIVER=local

# Local storage mode
STORAGE_LOCAL_DIR=.data/storage

# S3-compatible storage mode (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Local MinIO defaults (docker-compose-dev.yml)
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=veerify-assets
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_FORCE_PATH_STYLE=true

# Optional public base URL for storage object links (for CDN/custom host)
STORAGE_PUBLIC_BASE_URL=
# Keep proxy-required unless your S3-compatible target demonstrably enforces
# the signed Content-Length. Accepted value: content-length-enforced.
STORAGE_DIRECT_UPLOAD_CONSTRAINTS=proxy-required

# Upload token signing secret (REQUIRED — generate a random secret, e.g. `openssl rand -base64 32`)
# The server will refuse to start if this is not set.
UPLOAD_TOKEN_SECRET=

# --- Realtime / Redis -------------------------------------------------------
# Redis connection string. Written against the Redis wire protocol, so any
# provider works: Upstash on cloud, or the `valkey` service in docker-compose
# when self-hosting. Leave empty to run single-instance with in-memory drivers.
# Example: redis://localhost:6379  or  rediss://user:pass@host:6379
REDIS_URL=

# Realtime transport driver: `redis` | `memory`.
# Unset infers `redis` when REDIS_URL is set, otherwise `memory`.
# `memory` is single-instance ONLY — events do not cross app instances.
REALTIME_DRIVER=

# Rate limiter backing store: `redis` | `memory`.
# Same inference rule as REALTIME_DRIVER. `memory` does not enforce limits
# across instances. Shares the REDIS_URL connection; adds no extra socket.
RATE_LIMIT_STORE=

# --- Scheduled tasks --------------------------------------------------------
# Shared secret for the cron HTTP endpoints under /api/cron/*.
# REQUIRED if an external scheduler calls them: the endpoints fail closed, so an unset secret
# means every scheduled task returns 401 and silently never runs.
# Not needed when only Nitro's in-process scheduler runs the tasks.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Self-hosted deployment (docker-compose.yml) -----------------------------
# Public hostname serving uploaded assets through the Caddy reverse proxy.
# Required by docker-compose.yml and the Caddyfile when self-hosting.
# Example: assets.example.com
STORAGE_DOMAIN=

# --- Marketing ---------------------------------------------------------------
# Key used to encrypt workspace-supplied API keys (Anthropic, OpenAI, Firecrawl,
# PageSpeed) at rest. 32 bytes, base64 or hex. Required to store workspace keys.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Optional, comma-separated. Rotation: move the old SECRETS_ENCRYPTION_KEY value here and set a new
# SECRETS_ENCRYPTION_KEY. Stored secrets are re-encrypted hourly; remove this once Workspace settings >
# Integration status shows no keys on the previous key.
SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Maximum pages a single site audit may crawl (1-500, default 50)
MARKETING_MAX_AUDIT_PAGES=
# Manual audits a product may start per day (default 3)
MARKETING_MANUAL_AUDITS_PER_DAY=
# Instance-level fallback crawler. Teams can also bring their own Firecrawl key.
# Cloud (APP_DEPLOYMENT_MODE=cloud): FIRECRAWL_API_KEY and PAGESPEED_API_KEY are ignored unless
# MARKETING_ALLOW_INSTANCE_KEYS=true (they would give every team free crawling), so teams bring their own.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Instance-level Google PageSpeed Insights key (optional). Cloud: leave unset.
PAGESPEED_API_KEY=
# Cloud only: set to "true" to let the instance FIRECRAWL_API_KEY / PAGESPEED_API_KEY serve every team
# (leave empty until billing entitlements exist). Ignored when self-hosting, where instance keys always apply.
MARKETING_ALLOW_INSTANCE_KEYS=
# AI visibility throughput: answers in flight overall (default 24, max 50) and per LLM provider (default 8, max 20)
MARKETING_VISIBILITY_CONCURRENCY=
MARKETING_VISIBILITY_PROVIDER_CONCURRENCY=
# Scheduled weekly visibility runs pause while this many answers are pending (default 5000)
MARKETING_VISIBILITY_BACKLOG_LIMIT=
# Mentions poller: sites polled at once (default 16, max 32); each site polls its sources in parallel
MARKETING_MENTIONS_CONCURRENCY=
# Reddit API app credentials for mention monitoring (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: <platform>:<app id>:<version> (by /u/<reddit username>), e.g. web:io.veerify.marketing:1.0 (by /u/you)
REDDIT_USER_AGENT=
# Google OAuth app for Search Console (optional). Create a "Web application" client with the
# Search Console API enabled and add BETTER_AUTH_URL + /api/marketing/google/callback as an
# authorized redirect URI. Needs SECRETS_ENCRYPTION_KEY, because refresh tokens are stored encrypted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bluesky account (app password, not your login password) for mention monitoring (optional)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
