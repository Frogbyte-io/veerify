+          FROM pg_locks held
+          JOIN pg_class relation ON relation.oid = held.relation
+          WHERE held.pid = $1
+            AND relation.relname = 'contact'
+            AND held.mode = 'RowExclusiveLock'
+            AND held.granted
+        ) AS held
